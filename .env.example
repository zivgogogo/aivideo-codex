# Copy this file to .env in this directory. Existing system variables take priority.
DASHSCOPE_API_KEY=your-dashscope-api-key

# Beijing legacy endpoint (still supported); may include or omit /api/v1.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Recommended workspace endpoint: replace YOUR_WORKSPACE_ID and match key region.
# DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1
# Singapore: https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/api/v1

# LLM: independent OpenAI-compatible endpoint (not the video /api/v1 endpoint).
# Uses DASHSCOPE_API_KEY above. Match the endpoint, key and model region.
DASHSCOPE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Recommended workspace endpoint, replace YOUR_WORKSPACE_ID:
# DASHSCOPE_LLM_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_LLM_MODEL=qwen-plus
DASHSCOPE_LLM_TIMEOUT=120
DASHSCOPE_LLM_TEMPERATURE=0.7
DASHSCOPE_LLM_MAX_TOKENS=2048
# true / false / auto (auto omits the parameter for models that do not support it).
DASHSCOPE_LLM_ENABLE_THINKING=false
# Optional default for generate(), stream() and the CLI prompt input.
DASHSCOPE_LLM_SYSTEM_PROMPT=""

# Optional local project and policy files; relative paths start at the repository root.
# AIVIDEO_PROJECT_DIR=production/projects/default
# AIVIDEO_CONTINUITY_RULES=local/config/continuity-rules.json
# AIVIDEO_PLANNER_PROMPT_FILE=local/config/planner-prompt.md
# AIVIDEO_REVIEW_PROMPT_FILE=local/config/review-prompt.md
