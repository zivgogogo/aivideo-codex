# Only application source, tests, config templates and product docs belong in Git.
/*
!/ai/
!/backend/
!/core/
!/frontend/
!/resources/
!/scripts/
!/tests/
!/docs/
!/examples/
!/.github/
!/.gitignore
!/.gitattributes
!/.env.example
!/requirements.txt
!/README.md
!/项目目录说明.md
!/初始化项目.command
!/启动短剧画布.command
!/启动短剧工作台.command
