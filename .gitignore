.env
.env.*
!.env.example
*.pem
*.key
*.log
*.tmp
*.docx
*.mp4
*.mov
EP[0-9][0-9][0-9].md
*story-seed*.json
__pycache__/
*.py[cod]
*.egg-info/
node_modules/
.pytest_cache/
.coverage
.DS_Store
/resources/*
!/resources/rules/
